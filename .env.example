# ODSH-Native environment configuration sample — copy to .env and fill in
# 中文：环境配置样例，复制为 .env 后填写。
# All authentication values are placeholders: never commit any real token or key.
# The OpenClaw gateway token/device are provided by the host OpenClaw (peer), not bundled.

# ---- OpenClaw gateway (host / container network) ----
# When ODSH-Native runs on the same host as OpenClaw and 18789 is published to loopback:
#   OC_HOST=127.0.0.1
# When ODSH-Native runs in another container on the same Docker network:
#   OC_HOST=openclaw
OC_HOST=127.0.0.1
OC_PORT=18789
# gateway.auth.token from OpenClaw's openclaw.json
OC_TOKEN=REPLACE_WITH_GATEWAY_TOKEN
# origin: leave empty to auto-build http://<OC_HOST>:<OC_PORT> (must be in gateway.allowedOrigins)
OC_ORIGIN=
# Device identity JWK file path (Ed25519, auto-generated on first run)
OC_KEYS=
OC_CONNECT_TIMEOUT_MS=45000
OC_REPLY_TIMEOUT_MS=20000

# ---- B-class: DSH Harness worker bridge ----
# mode=remote requires a reachable HTTP endpoint (e.g. a DSH Cordis worker).
# Leave empty to use internal (local subprocess) mode.
DSH_WORKER_ENDPOINT=
# Optional bearer token sent as Authorization: Bearer <token> to the remote worker.
# Required to auth the remote (remote mode with no token is allowed but unauthenticated).
DSH_WORKER_TOKEN=

# ---- Cua Driver / computer-server (optional desktop & vision) ----
CUA_DRIVER=cua-driver
# Remote mode: set to a cua-computer-server URL when OpenClaw runs in a container
# and the desktop lives on the host (e.g. http://host.docker.internal:8000).
# Empty = local cua-driver (host install, simplest).
CUA_REMOTE=

# ---- Web search (RESERVED, not yet implemented — see README "Web search (planned)") ----
# The plugin currently ships no web-search tool. These keys are reserved for the
# planned SERPdive + TinyFish wiring so no .env churn is needed when it lands.
# SERPdive: search-as-answer (free ~1000 credits/mo, krill model free)
SERPDIVE_API_KEY=
# TinyFish: search + JS-rendered fetch (free at any balance)
TINYFISH_API_KEY=
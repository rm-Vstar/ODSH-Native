{
  "name": "odsh-native",
  "version": "2.0.3",
  "description": "ODSH-Native as an OpenClaw plugin: bring DSH execution + plugin/capability surface natively into OpenClaw (A-class agent tools + B-class resident services / DSH Harness hosting).",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "openclaw": {
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2"
    },
    "install": {
      "minHostVersion": ">=2026.3.24-beta.2"
    },
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "check": "node --experimental-strip-types scripts/check.mjs",
    "test": "node --experimental-strip-types tests/security.test.mjs && node --experimental-strip-types scripts/test.mjs",
    "build": "node scripts/build.mjs",
    "worker": "node src/worker/clean-exec.mjs",
    "tools": "node src/registry.mjs list"
  },
  "dependencies": {
    "typebox": "1.3.16"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24-beta.2"
  }
}
